# Copy to .env and fill in real values. Do not commit .env.
# Same DeepSeek settings as ToolBrain (https://platform.deepseek.com/)

DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com

# Available models (aligned with ToolBrain):
#   deepseek-v4-flash   - fast / cheap (default)
#   deepseek-v4-pro     - high quality, supports thinking mode
#   deepseek-chat       - legacy alias
#   deepseek-reasoner   - legacy alias
DEEPSEEK_MODEL=deepseek-v4-flash

DEEPSEEK_TEMPERATURE=0.3

# Thinking mode for v4 models (default disabled — this chat UI does not
# round-trip reasoning_content across turns).
#   disabled | enabled | auto
DEEPSEEK_THINKING=disabled

# Neo4j (for comments graph storage)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Redis (for comment caching)
REDIS_URL=redis://localhost:6379/0
COMMENT_CACHE_TTL=300

# Optional shared secret for this homepage proxy (must match params.agent.api_key)
# AGENT_API_KEY=

AGENT_CORS_ORIGINS=http://localhost:1313,http://127.0.0.1:1313,https://highlights925.github.io
AGENT_RATE_LIMIT_PER_MIN=20
AGENT_MAX_HISTORY=12
AGENT_MAX_INPUT_CHARS=2000
